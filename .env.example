APP_NAME=ReadLog
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local development uses SQLite and needs nothing else set.
DB_CONNECTION=sqlite

# Production runs on any standard PostgreSQL. Set DB_CONNECTION=pgsql and the six
# variables below; they are the whole of what the app reads for its connection.
# DB_SSLMODE is what hosts differ on: managed providers such as Neon want
# "require", a plain local container has no TLS and wants "disable", and the
# default "prefer" tries TLS first and falls back. A single DB_URL is accepted
# instead of the six if your provider hands you one.
# DB_CONNECTION=pgsql
# DB_HOST=
# DB_PORT=5432
# DB_DATABASE=readlog
# DB_USERNAME=
# DB_PASSWORD=
# DB_SSLMODE=require

# The remaining keys the sqlite and pgsql connections read. All have working
# defaults. DB_URL is a single connection string accepted instead of the six
# variables above; DB_FOREIGN_KEYS turns SQLite's foreign key enforcement off,
# which would break the cascade and restrict rules the schema relies on;
# DB_CHARSET applies to Postgres only.
# DB_URL=
# DB_FOREIGN_KEYS=true
# DB_CHARSET=utf8

# Set when the app sits behind a reverse proxy or a Cloudflare Tunnel, so it
# believes X-Forwarded-Proto and X-Forwarded-Host from that address. "127.0.0.1"
# for cloudflared running next to `php artisan serve`; "*" inside compose, where
# nginx is the only caller. Unset means forwarded headers are ignored.
# TRUSTED_PROXIES=127.0.0.1

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Book providers. Open Library needs no key. Without a Google Books key that
# provider is skipped: search falls back to Open Library only and the book detail
# page shows no details, which is what readlog-dotnet does.
# GOOGLE_BOOKS_API_KEY=

# Let the tests tagged "live" call the real APIs instead of using faked responses.
BOOK_SEARCH_LIVE_TESTS=false

# Provider base addresses and request bounds. Every one has a working default and
# none normally needs setting; they exist so a test or a mirror can point the app
# somewhere else. The timeout matches the 10 second HttpClient.Timeout the .NET
# app sets, and the limit is kept equal across providers so the merge stays
# balanced.
# OPEN_LIBRARY_BASE_URL=https://openlibrary.org/
# GOOGLE_BOOKS_BASE_URL=https://www.googleapis.com/books/v1/
# BOOK_SEARCH_TIMEOUT=10
# BOOK_SEARCH_LIMIT=15

# Where `php artisan readlog:smoke` points its HTTP checks when given no --url.
# Falls back to APP_URL. Inside the compose app container APP_URL is the host's
# address and is not reachable from there, so compose sets this to http://web.
# SMOKE_URL=

# "Ask your library": natural-language search over the reader's own entries,
# answered by a local Ollama (https://ollama.com). Entirely optional. When Ollama
# is not reachable the library search falls back to plain title matching and
# says so; nothing else in the app changes. Pull the two models once:
#     ollama pull nomic-embed-text && ollama pull qwen2.5:7b
AI_SEARCH_ENABLED=true
OLLAMA_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_CHAT_MODEL=qwen2.5:7b

# Timeouts in seconds, all measured rather than guessed. See decision 103. The
# probe decides "is Ollama there" and runs on a page request, so it must be fast.
# Embedding and generating may take much longer: on a GPU shared with two other
# models the first question after a while took 47 seconds while the chat model
# loaded, and the ones after it 0.5 to 4 seconds.
# OLLAMA_PROBE_TIMEOUT=2
# OLLAMA_EMBED_TIMEOUT=60
# OLLAMA_GENERATE_TIMEOUT=90
#
# Embedding one entry right after it is saved is bounded much tighter, because a
# save must never wait for a cold model to load. A missed embedding is filled in
# by the next search or by `readlog:embed`, which gets the long bound precisely so
# it can absorb that load.
# OLLAMA_WRITE_EMBED_TIMEOUT=5
# OLLAMA_BACKFILL_EMBED_TIMEOUT=120
#
# How long a successful or failed probe is trusted before asking again.
# OLLAMA_PROBE_CACHE=60
#
# nomic-embed-text is trained with task prefixes and ranks noticeably better with
# them; other models ignore them or do not want them. Set both to empty for a
# model without prefixes. Changing the document prefix re-embeds every entry on
# the next `readlog:embed`, because the stored hash covers it.
# OLLAMA_EMBED_DOCUMENT_PREFIX="search_document: "
# OLLAMA_EMBED_QUERY_PREFIX="search_query: "
#
# How many ranked entries the chat model is shown, and how many still-unembedded
# entries one search will embed on the spot before answering. The rest wait for
# `readlog:embed`.
# OLLAMA_ASK_CANDIDATES=8
# OLLAMA_ASK_BACKFILL_LIMIT=50
